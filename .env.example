# --- Required (add these in Vercel > Project > Settings > Environment Variables) ---
BOT_TOKEN=paste_your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=paste_a_long_random_secret_here

# --- Optional ---
MAX_MB=48
LOW_HEIGHT=360
MAX_PARALLEL=2
USER_COOLDOWN=10
CHECK_COOLDOWN=3
# Leave empty to let yt-dlp handle any supported public site
# ALLOWED_DOMAINS=instagram.com,youtube.com,youtu.be,reddit.com,facebook.com
# Your Telegram user id (from @userinfobot): you will see raw error details
# OWNER_ID=123456789
# Set to 1 only while debugging: finish the work before answering Telegram
# INLINE_PROCESSING=0
