# --- Required (add these in Vercel > Project > Settings > Environment Variables) ---
BOT_TOKEN=paste_your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=paste_a_long_random_secret_here

# --- Optional ---
MAX_MB=48
LOW_HEIGHT=360
MAX_PARALLEL=2
USER_COOLDOWN=10
CHECK_COOLDOWN=3
# Leave empty to let yt-dlp handle any supported public site
# ALLOWED_DOMAINS=instagram.com,youtube.com,youtu.be,reddit.com,facebook.com
# Your Telegram user id (from @userinfobot): you will see raw error details
# OWNER_ID=123456789
# Set to 1 only while debugging: finish the work before answering Telegram
# INLINE_PROCESSING=0

# YouTube direct-media fallback through RapidAPI.
# Required for YouTube links in the current deployment path.
# RAPID_API_KEY=paste_your_rapidapi_key_here
# RAPID_API_HOST=youtube-media-downloader.p.rapidapi.com
# RAPID_API_URL=https://youtube-media-downloader.p.rapidapi.com/v2/video/details

# Optional yt-dlp Netscape-format cookies. In Vercel, store the complete
# cookie text as an environment variable; never commit a cookie file.
# YT_COOKIES=
